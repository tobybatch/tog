@prefix ex: <http://example.org/digitaltwin#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex: a owl:Ontology .

ex:Bankstatement a owl:Class ;
    rdfs:label "BankStatement" ;
    rdfs:comment "A document issued by a bank to show account balance and transactions" .

ex:Passport a owl:Class ;
    rdfs:label "Passport" ;
    rdfs:comment "A travel document issued by a government to its citizens" .

ex:Temporaryworkcreativeworkervisa a owl:Class ;
    rdfs:label "TemporaryWorkCreativeWorkerVisa" ;
    rdfs:comment "A type of visa for temporary workers in the creative industry" .

ex:Tuberculosistestresult a owl:Class ;
    rdfs:label "TuberculosisTestResult" ;
    rdfs:comment "A document issued by a medical professional to confirm TB test results" .

ex:Ukvcas a ex:Service,
        owl:NamedIndividual ;
    rdfs:label "UKVCAS" ;
    rdfs:comment "A UK Visa and Citizenship Application Services service point" .

ex:Ukvisa a owl:Class ;
    rdfs:label "UKVisa" ;
    rdfs:comment "A visa that allows an individual to work in the UK" .

ex:Ukvisasandimmigrationaccount a owl:Class ;
    rdfs:label "UKVisasAndImmigrationAccount" ;
    rdfs:comment "An online account for UKVI services" .

ex:Unitedkingdom a ex:Country,
        owl:NamedIndividual ;
    rdfs:label "UnitedKingdom" ;
    rdfs:comment "The country where the visa application is being made" .

ex:applicationnumber a owl:DatatypeProperty ;
    rdfs:label "applicationNumber" ;
    rdfs:comment "The unique application number assigned to the visa application" ;
    rdfs:domain ex:Application ;
    rdfs:range xsd:string .

ex:decisiondate a owl:DatatypeProperty ;
    rdfs:label "decisionDate" ;
    rdfs:comment "The date of the visa decision" ;
    rdfs:domain ex:Visaapplication ;
    rdfs:range xsd:date .

ex:hasamount a owl:DatatypeProperty ;
    rdfs:label "hasAmount" ;
    rdfs:comment "The amount of money required for financial support" ;
    rdfs:domain ex:Financialsupport ;
    rdfs:range xsd:integer .

ex:hasapplicant a owl:ObjectProperty ;
    rdfs:label "hasApplicant" ;
    rdfs:comment "The individual who submitted the visa application",
        "The person sponsored by the certificate" ;
    rdfs:domain ex:Certificateofsponsorship,
        ex:Visaapplication ;
    rdfs:range ex:Application,
        ex:Person .

ex:hascertificateofsponsorship a owl:ObjectProperty ;
    rdfs:label "hasCertificateOfSponsorship" ;
    rdfs:comment "The certificate of sponsorship given by the employer" ;
    rdfs:domain ex:Creativeworker ;
    rdfs:range ex:Certificateofsponsorship .

ex:hasdateassigned a owl:DatatypeProperty ;
    rdfs:label "hasDateAssigned" ;
    rdfs:comment "The date the certificate of sponsorship was assigned" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range xsd:date .

ex:hasdatevalid a owl:DatatypeProperty ;
    rdfs:label "hasDateValid" ;
    rdfs:comment "The date the certificate of sponsorship is valid until" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range xsd:date .

ex:hasdependant a owl:ObjectProperty ;
    rdfs:label "hasDependant" ;
    rdfs:comment "The partner or child of the visa applicant" ;
    rdfs:domain ex:Application ;
    rdfs:range ex:Dependant .

ex:hasduration a owl:DatatypeProperty ;
    rdfs:label "hasDuration" ;
    rdfs:comment "The duration of the certificate of sponsorship in days" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range xsd:integer .

ex:hasemployer a owl:ObjectProperty ;
    rdfs:label "hasEmployer" ;
    rdfs:comment "The employer sponsoring the worker" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range ex:Employer .

ex:hasemployersupport a owl:DatatypeProperty ;
    rdfs:label "hasEmployerSupport" ;
    rdfs:comment "Whether the employer can support the individual financially" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range xsd:boolean .

ex:hasfee a owl:ObjectProperty ;
    rdfs:label "hasFee" ;
    rdfs:comment "The fee required for the visa application" ;
    rdfs:domain ex:Visaapplication ;
    rdfs:range ex:Fee .

ex:hasfinancialsupport a owl:ObjectProperty ;
    rdfs:label "hasFinancialSupport" ;
    rdfs:comment "The ability to support oneself financially in the UK" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range ex:Financialsupport .

ex:hasjob a owl:ObjectProperty ;
    rdfs:label "hasJob" ;
    rdfs:comment "The position or role within the organisation" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range ex:Job .

ex:haspersonaldetails a owl:ObjectProperty ;
    rdfs:label "hasPersonalDetails" ;
    rdfs:comment "The information about the individual's identity and contact details" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range ex:Personaldetails .

ex:hassponsor a owl:ObjectProperty ;
    rdfs:label "hasSponsor" ;
    rdfs:comment "The organisation that gave the certificate of sponsorship" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range ex:Sponsor .

ex:isemployedby a owl:ObjectProperty ;
    rdfs:label "isEmployedBy" ;
    rdfs:comment "The organisation that employs the individual" ;
    rdfs:domain ex:Creativeworker ;
    rdfs:range ex:Employer .

ex:personalsavings a owl:DatatypeProperty ;
    rdfs:label "personalSavings" ;
    rdfs:comment "The amount of personal savings" ;
    rdfs:domain ex:Person ;
    rdfs:range xsd:integer .

ex:providedby a owl:ObjectProperty ;
    rdfs:label "providedBy" ;
    rdfs:comment "The service that provided the support for the visa application" ;
    rdfs:domain ex:Service ;
    rdfs:range ex:Service .

ex:requiresevidence a owl:ObjectProperty ;
    rdfs:label "requiresEvidence" ;
    rdfs:comment "The evidence required for the visa application" ;
    rdfs:domain ex:Visaapplication ;
    rdfs:range ex:Evidence .

ex:sponsorcertifiesmaintenance a owl:DatatypeProperty ;
    rdfs:label "sponsorCertifiesMaintenance" ;
    rdfs:comment "Whether the employer certifies maintenance" ;
    rdfs:domain ex:Certificateofsponsorship ;
    rdfs:range xsd:boolean .

ex:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country where a visa application is being made" .

ex:Dependant a owl:Class ;
    rdfs:label "Dependant" ;
    rdfs:comment "A partner or child of a visa applicant" .

ex:Evidence a owl:Class ;
    rdfs:label "Evidence" ;
    rdfs:comment "A document or information required to support a visa application" .

ex:Fee a owl:Class ;
    rdfs:label "Fee" ;
    rdfs:comment "A payment required for a visa application" .

ex:Job a owl:Class ;
    rdfs:label "Job" ;
    rdfs:comment "A position or role within an organisation" .

ex:Personaldetails a owl:Class ;
    rdfs:label "PersonalDetails" ;
    rdfs:comment "Information about an individual's identity and contact details" .

ex:Sponsor a owl:Class ;
    rdfs:label "Sponsor" ;
    rdfs:comment "An organisation that gives a certificate of sponsorship" .

ex:Creativeworker a owl:Class ;
    rdfs:label "CreativeWorker" ;
    rdfs:comment "An individual who works in a creative field" .

ex:Employer a owl:Class ;
    rdfs:label "Employer" ;
    rdfs:comment "An organisation that employs an individual" .

ex:Financialsupport a owl:Class ;
    rdfs:label "FinancialSupport" ;
    rdfs:comment "The ability to support oneself financially in the UK" .

ex:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A class representing Person." .

ex:Application a owl:Class ;
    rdfs:label "Application" ;
    rdfs:comment "A visa application submitted by an individual" .

ex:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A service provided by the Home Office for visa applications" .

ex:Visaapplication a owl:Class ;
    rdfs:label "VisaApplication" ;
    rdfs:comment "A visa application submitted to the Home Office" .

ex:Certificateofsponsorship a owl:Class ;
    rdfs:label "CertificateOfSponsorship" ;
    rdfs:comment "A reference number holding information about the job and personal details" .

