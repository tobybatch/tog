    <orderEntry type="library" name="n3" level="application" />
    <orderEntry type="library" name="graphology" level="application" />
    <orderEntry type="library" name="sigma.js" level="application" />
  </component>
  <component name="PyDocumentationSettings">
    <option name="format" value="PLAIN" />
  </component>
</module>